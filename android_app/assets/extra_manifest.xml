<queries>
    <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:mimeType="vnd.android.document/directory" />
    </intent>
    <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:mimeType="resource/folder" />
    </intent>
    <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:mimeType="video/*" />
    </intent>
    <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:mimeType="audio/*" />
    </intent>
    <intent>
        <action android:name="android.intent.action.VIEW_DOWNLOADS" />
    </intent>
    <!-- Inbuilt OEM File Managers -->
    <package android:name="com.sec.android.app.myfiles" />
    <package android:name="com.mi.android.globalFileexplorer" />
    <package android:name="com.android.fileexplorer" />
    <package android:name="com.coloros.filemanager" />
    <package android:name="com.oneplus.filemanager" />
    <package android:name="com.vivo.filemanager" />
    <package android:name="com.huawei.hidisk" />
    <package android:name="com.lenovo.filebrowser" />
    <package android:name="com.asus.filemanager" />
    <package android:name="com.transsion.filemanager" />
    <!-- Popular Third-Party File Explorers -->
    <package android:name="ru.zdevs.zarchiver" />
    <package android:name="ru.zdevs.zarchiver.pro" />
    <package android:name="com.estrongs.android.pop" />
    <package android:name="com.cxinventor.file.explorer" />
    <package android:name="pl.solidexplorer2" />
    <package android:name="com.mixplorer" />
    <package android:name="com.mixplorer.silver" />
    <package android:name="com.ghisler.android.TotalCommander" />
    <package android:name="com.alphainventor.filemanager" />
    <package android:name="me.zhanghai.android.files" />
    <package android:name="com.lonelycatgames.Xplore" />
    <package android:name="com.amaze.filemanager" />
    <package android:name="com.google.android.apps.nbu.files" />
    <package android:name="com.android.documentsui" />
</queries>
